# Copy to .env.gateway for gateway.admin.yml
#
# CI 推送命名见 .github/workflows/cinatoken-docker-images.yml（本组织默认如下）。
GATEWAY_ADMIN_IMAGE=ghcr.io/cinagroup/cinatoken-admin:latest
# 任意私有 OCI registry（如自建 Harbor）：按需 mirror / retag，例如：
# GATEWAY_ADMIN_IMAGE=registry.example.com/example-org/cinatoken-admin:latest

# 仅用于 `docker compose --profile migrate run --rm migrate`：用 **migrate 镜像**跑一次性 DB 迁移（不要求部署 gateway-proxy 容器）。
GATEWAY_MIGRATE_IMAGE=ghcr.io/cinagroup/cinatoken-migrate:latest
# GATEWAY_MIGRATE_IMAGE=registry.example.com/example-org/cinatoken-migrate:latest

# 宿主机映射端口（默认 18789）；容器内固定 8789
GATEWAY_ADMIN_PORT=18789

# 与 proxy 使用同一逻辑库（首次建库请先执行上行的 migrate）；MySQL 时改为 mysql:// 并设 DATABASE_DRIVER=mysql
DATABASE_URL=postgres://gateway_user:change-me@db.example.com:5432/cinatoken
DATABASE_DRIVER=postgres

# 可选：容器启动前自动迁移。默认关闭；通常只需在 proxy 或 admin 之一开启。
# AUTO_MIGRATE=1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 可选加固：已用 HTTPS 访问 Admin 时，取消下一行注释可为会话 Cookie 加上 Secure。
# 默认不设即可登录；见 docs/operators/deployment/docker.md §7.3。
# ADMIN_COOKIE_SECURE=1

# 用户门户链上操作（/account 提现 CINA-C + 贡献 NFT 铸造；cinachain = Base Sepolia）
# 不配置时门户提现/铸造返回 503，其余功能不受影响。见 docs/users/portal.md。
# CINACHAIN_RPC_URL=https://sepolia.base.org
# CINACHAIN_CHAIN_ID=84532
# CINABADGE_CONTRACT_ADDRESS=0x72cc9adb6c877d233e9843ee2d00424b9766d0cf
# CINACREDIT_CONTRACT_ADDRESS=0x78f5aebc75b7d197b10622cccabe8429617836d7
# CINACHAIN_MINTER_PRIVATE_KEY=0x...

map $status $web_docs_cache {
    default "no-cache, no-transform";
    503 no-store;
}

map $status $web_docs_robots {
    default "";
    503 noindex;
}

map $request_method $web_reference_read {
    default 0;
    GET 1;
    HEAD 1;
    OPTIONS 2;
}
map $status $web_reference_cache {
    default no-store;
    200 "public, max-age=300, must-revalidate";
    304 "public, max-age=300, must-revalidate";
}
# Docs pages have a separate rollout switch; assets survive rollback.
map "${CINATOKEN_WEB_DOCS_ENABLED}:$request_method" $web_docs_page {
    default 0;
    "~^true:(GET|HEAD)$" 1;
}

# All eight public pages share a single disabled-by-default SSR entry.
map "${CINATOKEN_WEB_PUBLIC_ENABLED}:$request_method:$request_uri" $web_public_ssr {
    default 0;
    "~^true:(GET|HEAD):/([?].*)?$" 1;
    "~^true:(GET|HEAD):/(en|zh|ja|ko)(/[^?]*)?([?].*)?$" 1;
    "~^true:(GET|HEAD):/(models(/[^?]*)?|providers/?|compare/?|chat/?|rankings/?|benchmarks/?|robots[.]txt|sitemap[.]xml)([?].*)?$" 1;
    "~^true:(GET|HEAD):/[a-z]{2}(?:-[A-Za-z]{2})?/(models(/[^?]*)?|providers/?|compare/?|chat/?|rankings/?|benchmarks/?)([?].*)?$" 1;
}

# Included in nginx's http context. Only approved GET/HEAD pages use the shell.
map "${CINATOKEN_WEB_ACCOUNT_ENABLED}:$request_method:$request_uri" $web_account_shell {
    default 0;
    "~^true:(GET|HEAD):/account/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/keys/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/byok/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/activity/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/earnings/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/nft/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/withdraw/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/presets/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/guardrails/?([?].*)?$" 1;
    "~^true:(GET|HEAD):/account/settings/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_DASHBOARD_ENABLED}:$request_method:$request_uri" $web_admin_dashboard_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_USERS_ENABLED}:$request_method:$request_uri" $web_admin_users_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/users/?([?].*)?$" 1;
}

# Only UUIDs and simple canonical ext%3Asystem%2Fuser IDs are opted in.
# Encoded payloads inside either ext component keep the Admin fallback.
map "${CINATOKEN_WEB_ADMIN_USER_DETAIL_ENABLED}:$request_method:$request_uri" $web_admin_user_detail_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/users/(?:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}|ext%3A[A-Za-z0-9._~-]{1,600}%2F[A-Za-z0-9._~-]{1,600})/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_PROVIDERS_ENABLED}:$request_method:$request_uri" $web_admin_provider_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/providers/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_MODELS_ENABLED}:$request_method:$request_uri" $web_admin_model_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/models/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_ENDPOINTS_ENABLED}:$request_method:$request_uri" $web_admin_endpoint_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/endpoints/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_ROUTES_ENABLED}:$request_method:$request_uri" $web_admin_route_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/routes/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_DATA_POLICIES_ENABLED}:$request_method:$request_uri" $web_admin_data_policy_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/data-policies/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_PRESETS_ENABLED}:$request_method:$request_uri" $web_admin_presets_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/presets/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_GUARDRAILS_ENABLED}:$request_method:$request_uri" $web_admin_guardrails_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/guardrails/?([?].*)?$" 1;

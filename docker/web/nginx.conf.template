map "${CINATOKEN_WEB_ADMIN_RELIABILITY_ENABLED}:$request_method:$request_uri" $web_admin_reliability_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/analytics/reliability/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_MODEL_ANALYTICS_ENABLED}:$request_method:$request_uri" $web_admin_model_analytics_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/analytics/models/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_PROVIDER_ANALYTICS_ENABLED}:$request_method:$request_uri" $web_admin_provider_analytics_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/analytics/providers/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_USER_ANALYTICS_ENABLED}:$request_method:$request_uri" $web_admin_user_analytics_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/analytics/users/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_REQUEST_LOGS_ENABLED}:$request_method:$request_uri" $web_admin_request_logs_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/request-logs/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_BUDGET_AUDIT_ENABLED}:$request_method:$request_uri" $web_admin_budget_audit_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/audit-logs/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_TOOL_INVOCATIONS_ENABLED}:$request_method:$request_uri" $web_admin_tool_invocations_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/tools/invocations/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_CONFIG_TIMEZONE_ENABLED}:$request_method:$request_uri" $web_admin_config_timezone_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/config/timezone/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_CONFIG_ENABLED}:$request_method:$request_uri" $web_admin_config_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/config/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_ACCESS_KEYS_ENABLED}:$request_method:$request_uri" $web_admin_access_keys_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/admin-api-keys/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_KEYS_ENABLED}:$request_method:$request_uri" $web_admin_keys_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/keys/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_SHARED_KEYS_ENABLED}:$request_method:$request_uri" $web_admin_shared_keys_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/shared-keys/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_TOOLS_ENABLED}:$request_method:$request_uri" $web_admin_tools_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/tools/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_PLAYGROUND_ENABLED}:$request_method:$request_uri" $web_admin_playground_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/playground/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_SIMULATOR_ENABLED}:$request_method:$request_uri" $web_admin_simulator_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/simulator/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_MCP_ENABLED}:$request_method:$request_uri" $web_admin_mcp_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/mcp/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_WITHDRAWALS_ENABLED}:$request_method:$request_uri" $web_admin_withdrawals_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/withdrawals/?([?].*)?$" 1;
}

map "${CINATOKEN_WEB_ADMIN_NFT_MINTS_ENABLED}:$request_method:$request_uri" $web_admin_nft_mints_shell {
    default 0;
    "~^true:(GET|HEAD):/admin/nft-mints/?([?].*)?$" 1;
}

map $http_upgrade $web_connection_upgrade {
    default upgrade;
    '' '';
}

# Preserve the public scheme when TLS terminates at the ingress before nginx.
# Direct HTTP development falls back to nginx's own scheme.
map $http_x_forwarded_proto $web_public_proto {
    default $scheme;
    http http;
    https https;
}

map $request_method $web_asset_read {
    default 0;
    GET 1;
    HEAD 1;
}

# Keep this exact hash recognition in sync with scripts/asset-policy.mjs.
# Errors and HTML never inherit the immutable cache policy.
map "$status:$request_uri" $web_asset_cache_control {
    default no-store;
    "~*^(200|206|304):/web-assets/.*[.]html?([?].*)?$" no-store;
    "~^(200|206|304):/web-assets/static/[A-Za-z0-9_./-]+[.][a-f0-9]{8,64}[.](?:js|css|woff2?|ttf|otf|png|jpe?g|svg|webp|avif|ico)(?:[.]LICENSE[.]txt)?([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/web-assets/sources/web[.][a-f0-9]{64}[.]tar[.]gz([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/(?:web-assets/)?docs-assets/search/[a-f0-9]{64}/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/(?:web-assets/)?docs-assets/static/[A-Za-z0-9_.-]+[.][A-Za-z0-9_-]{5,64}[.](?:js|css|svg|png|woff2?)([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/web-assets/" no-cache;
    "~^(200|206|304):/docs-assets/" no-cache;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    resolver ${CINATOKEN_WEB_DNS_RESOLVER} valid=30s ipv6=off;
    set $web_admin_origin "${CINATOKEN_ADMIN_UPSTREAM}";

    # Public Chat already caps its body at 12 MiB; Admin enforces its own bounds.
    client_max_body_size 12m;
    error_page 418 = @web_index;
    error_page 419 = @admin;
    error_page 420 = @public_ssr;
    set $public_ssr_upstream "${CINATOKEN_WEB_SSR_UPSTREAM}";

    location ^~ /web-assets/ {
        if ($web_asset_read = 0) { return 419; }
        alias /usr/share/nginx/html/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control $web_asset_cache_control always;
        # The asset namespace remains available when account rollout is off.
        # Missing files use nginx's 404, never an index.html fallback.
    }

    location ^~ /docs-assets/ {
        if ($web_asset_read = 0) { return 419; }
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control $web_asset_cache_control always;
    }

    location ~ ^/docs/?$ {
        if ($web_asset_read = 0) { return 419; }
        add_header Cache-Control no-store always;
        return 307 /en/docs/;
    }

    location ~ ^/(?<quickstart_locale>en|zh)/docs/quick-start/?$ {
        if ($web_asset_read = 0) { return 419; }
        if ($web_docs_page = 0) { return 503; }
        add_header Cache-Control no-cache always;
        return 307 /$quickstart_locale/docs/quickstart/$is_args$args;
    }
    location ~ ^/(?<keys_locale>en|zh)/docs/guides/api-keys/?$ {
        if ($web_asset_read = 0) { return 419; }
        if ($web_docs_page = 0) { return 503; }
        add_header Cache-Control no-cache always;
        return 307 /$keys_locale/docs/keys/$is_args$args;
    }
    location ~ ^/(?<models_locale>en|zh)/docs/guides/models/?$ {
        if ($web_asset_read = 0) { return 419; }
        if ($web_docs_page = 0) { return 503; }
        add_header Cache-Control no-cache always;
        return 307 /$models_locale/docs/models/$is_args$args;
    }
    location ~ ^/(en|zh)/(docs|updates|reference)(?:/[a-z0-9-]+)*/?$ {
        if ($web_asset_read = 0) { return 419; }
        if ($web_docs_page = 0) { return 503; }
        try_files $uri/index.html =404;
        add_header Cache-Control $web_docs_cache always;
        add_header X-Robots-Tag $web_docs_robots always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    }

    location ~ ^/reference/(?:api/catalog|catalog)/(?<reference_catalog_name>models|providers)(?:[.]json)?/?$ {
        if ($web_reference_read = 2) { return 204; }
        if ($web_asset_read = 0) { return 419; }
        error_page 404 = @reference_not_found;
        alias /usr/share/nginx/html/reference/catalog/$reference_catalog_name.json;
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "ETag" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control $web_reference_cache always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, If-None-Match" always;
    }
    location ~ ^/reference/(?:api/catalog|catalog)/models-by-vendor/(?<reference_vendor>[a-z0-9_-]+?)(?:[.]json)?/?$ {
        if ($web_reference_read = 2) { return 204; }
        if ($web_asset_read = 0) { return 419; }
        error_page 404 = @reference_not_found;
        alias /usr/share/nginx/html/reference/catalog/models-by-vendor/$reference_vendor.json;
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "ETag" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control $web_reference_cache always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, If-None-Match" always;
    }
    location /reference/api/catalog/ {
        if ($web_reference_read = 0) { return 419; }
        error_page 404 = @reference_not_found;
        return 404;
    }
    location /reference/catalog/ {
        if ($web_reference_read = 0) { return 419; }
        error_page 404 = @reference_not_found;
        return 404;
    }
    location @reference_not_found {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "ETag" always;
        add_header X-Content-Type-Options nosniff always;
        return 404 '{"error":"reference_not_found"}';
    }
    location ~ ^/(content-sitemap|updates)[.]xml$ {
        if ($web_asset_read = 0) { return 419; }
        try_files $uri =404;
        types { application/xml xml; }
        default_type application/xml;
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options nosniff always;
    }
    location / {
        if ($web_public_ssr = 1) { return 420; }
        if ($web_account_shell = 1) { return 418; }
        if ($web_admin_dashboard_shell = 1) { return 418; }
        if ($web_admin_users_shell = 1) { return 418; }
        if ($web_admin_user_detail_shell = 1) { return 418; }
        if ($web_admin_provider_shell = 1) { return 418; }
        if ($web_admin_model_shell = 1) { return 418; }
        if ($web_admin_endpoint_shell = 1) { return 418; }
        if ($web_admin_route_shell = 1) { return 418; }
        if ($web_admin_data_policy_shell = 1) { return 418; }
        if ($web_admin_presets_shell = 1) { return 418; }
        if ($web_admin_guardrails_shell = 1) { return 418; }
        if ($web_admin_reliability_shell = 1) { return 418; }
        if ($web_admin_model_analytics_shell = 1) { return 418; }
        if ($web_admin_provider_analytics_shell = 1) { return 418; }
        if ($web_admin_user_analytics_shell = 1) { return 418; }
        if ($web_admin_request_logs_shell = 1) { return 418; }
        if ($web_admin_budget_audit_shell = 1) { return 418; }
        if ($web_admin_tool_invocations_shell = 1) { return 418; }
        if ($web_admin_config_timezone_shell = 1) { return 418; }
        if ($web_admin_config_shell = 1) { return 418; }
        if ($web_admin_access_keys_shell = 1) { return 418; }
        if ($web_admin_keys_shell = 1) { return 418; }
        if ($web_admin_shared_keys_shell = 1) { return 418; }
        if ($web_admin_tools_shell = 1) { return 418; }
        if ($web_admin_playground_shell = 1) { return 418; }
        if ($web_admin_simulator_shell = 1) { return 418; }
        if ($web_admin_mcp_shell = 1) { return 418; }
        if ($web_admin_withdrawals_shell = 1) { return 418; }
        if ($web_admin_nft_mints_shell = 1) { return 418; }
        include /etc/nginx/web-admin-proxy.conf;
    }

    location @public_ssr {
        proxy_pass $public_ssr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-CinaToken-Web-Manifest "${CINATOKEN_WEB_MANIFEST_SHA}";
        proxy_buffering off;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control no-store always;
        error_page 502 504 =503 @public_ssr_unavailable;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location @public_ssr_unavailable {
        default_type text/plain;
        add_header Cache-Control no-store always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Retry-After 30 always;
        add_header X-Content-Type-Options nosniff always;
        return 503 "Public pages are unavailable";
    }

    location @admin {
        include /etc/nginx/web-admin-proxy.conf;
    }

    location @web_index {
        try_files /index.html =503;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; connect-src ${CINATOKEN_WEB_PROXY_CONNECT_SRC}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'" always;
    }
}

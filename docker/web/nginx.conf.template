map $http_upgrade $web_connection_upgrade {
    default upgrade;
    '' '';
}

# Preserve the public scheme when TLS terminates at the ingress before nginx.
# Direct HTTP development falls back to nginx's own scheme.
map $http_x_forwarded_proto $web_public_proto {
    default $scheme;
    http http;
    https https;
}

map $request_method $web_asset_read {
    default 0;
    GET 1;
    HEAD 1;
}

# Keep this exact hash recognition in sync with scripts/asset-policy.mjs.
# Errors and HTML never inherit the immutable cache policy.
map "$status:$request_uri" $web_asset_cache_control {
    default no-store;
    "~*^(200|206|304):/web-assets/.*[.]html?([?].*)?$" no-store;
    "~^(200|206|304):/web-assets/static/[A-Za-z0-9_./-]+[.][a-f0-9]{8,64}[.](?:js|css|woff2?|ttf|otf|png|jpe?g|svg|webp|avif|ico)(?:[.]LICENSE[.]txt)?([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/web-assets/sources/web[.][a-f0-9]{64}[.]tar[.]gz([?].*)?$" "public, max-age=31536000, immutable";
    "~^(200|206|304):/web-assets/" no-cache;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    resolver ${CINATOKEN_WEB_DNS_RESOLVER} valid=30s ipv6=off;
    set $web_admin_origin "${CINATOKEN_ADMIN_UPSTREAM}";

    # Public Chat already caps its body at 12 MiB; Admin enforces its own bounds.
    client_max_body_size 12m;
    error_page 418 = @web_index;
    error_page 419 = @admin;
    error_page 420 = @public_ssr;
    set $public_ssr_upstream "${CINATOKEN_WEB_SSR_UPSTREAM}";

    location ^~ /web-assets/ {
        if ($web_asset_read = 0) { return 419; }
        alias /usr/share/nginx/html/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control $web_asset_cache_control always;
        # The asset namespace remains available when account rollout is off.
        # Missing files use nginx's 404, never an index.html fallback.
    }

    location / {
        if ($web_public_ssr = 1) { return 420; }
        if ($web_account_shell = 1) { return 418; }
        if ($web_admin_dashboard_shell = 1) { return 418; }
        if ($web_admin_users_shell = 1) { return 418; }
        if ($web_admin_user_detail_shell = 1) { return 418; }
        if ($web_admin_provider_shell = 1) { return 418; }
        if ($web_admin_model_shell = 1) { return 418; }
        if ($web_admin_endpoint_shell = 1) { return 418; }
        if ($web_admin_route_shell = 1) { return 418; }
        if ($web_admin_data_policy_shell = 1) { return 418; }
        if ($web_admin_presets_shell = 1) { return 418; }
        if ($web_admin_guardrails_shell = 1) { return 418; }
        if ($web_admin_reliability_shell = 1) { return 418; }
        if ($web_admin_model_analytics_shell = 1) { return 418; }
        if ($web_admin_provider_analytics_shell = 1) { return 418; }
        if ($web_admin_user_analytics_shell = 1) { return 418; }
        if ($web_admin_request_logs_shell = 1) { return 418; }
        if ($web_admin_budget_audit_shell = 1) { return 418; }
        if ($web_admin_tool_invocations_shell = 1) { return 418; }
        if ($web_admin_config_timezone_shell = 1) { return 418; }
        if ($web_admin_config_shell = 1) { return 418; }
        if ($web_admin_access_keys_shell = 1) { return 418; }
        if ($web_admin_keys_shell = 1) { return 418; }
        if ($web_admin_shared_keys_shell = 1) { return 418; }
        if ($web_admin_tools_shell = 1) { return 418; }
        if ($web_admin_playground_shell = 1) { return 418; }
        if ($web_admin_simulator_shell = 1) { return 418; }
        if ($web_admin_withdrawals_shell = 1) { return 418; }
        if ($web_admin_nft_mints_shell = 1) { return 418; }
        include /etc/nginx/web-admin-proxy.conf;
    }

    location @public_ssr {
        proxy_pass $public_ssr_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-CinaToken-Web-Manifest "${CINATOKEN_WEB_MANIFEST_SHA}";
        proxy_buffering off;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control no-store always;
        error_page 502 504 =503 @public_ssr_unavailable;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location @public_ssr_unavailable {
        default_type text/plain;
        add_header Cache-Control no-store always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Retry-After 30 always;
        add_header X-Content-Type-Options nosniff always;
        return 503 "Public pages are unavailable";
    }

    location @admin {
        include /etc/nginx/web-admin-proxy.conf;
    }

    location @web_index {
        try_files /index.html =503;
        add_header Cache-Control no-store always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; connect-src ${CINATOKEN_WEB_PROXY_CONNECT_SRC}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'" always;
    }
}

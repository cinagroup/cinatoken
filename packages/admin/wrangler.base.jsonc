{
	// 模板：由 `npm run gen:wrangler` 生成 `wrangler.jsonc`（勿手改生成文件）。
	// Gateway Admin（Next.js OpenNext）：Cloudflare 部署仅支持 D1；管理 API 为 `/api/admin/*`（Hono `/admin/*`）。
	// 本地 preview 与 db:migrate 共用 .wrangler/state；远程 deploy 写入 database_id 后须再 npm run gen:wrangler 才能与 migrate 一致。
	// OIDC 与桥接密钥勿写入本文件：本地使用 `.dev.vars`，生产使用 Cloudflare Worker Secrets。
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cinatoken-admin",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "cinatoken.com/*",
			"zone_name": "cinatoken.com"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cinatoken",
			"migrations_dir": "../core/migrations-d1"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "CHAIN_JOBS",
				"queue": "cinatoken-chain-jobs"
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"services": [
		{
			"binding": "CINAAUTH_AUTH_SERVICE",
			"service": "cinaauth-api"
		}
	],
	"secrets": {
		"required": [
			"CINATOKEN_OIDC_CLIENT_SECRET",
			"CINATOKEN_OIDC_BRIDGE_SECRET",
			"CINATOKEN_OIDC_TRANSACTION_SECRET",
			"SHARED_KEY_ENCRYPTION_SECRET"
		]
	},
	"vars": {
		"CINAAUTH_ISSUER": "https://auth.cinaseek.ai",
		"CINAAUTH_ACCOUNT_ORIGIN": "https://accounts.cinaseek.ai",
		"CINATOKEN_APP_ORIGIN": "https://cinatoken.com",
		"CINATOKEN_OIDC_CLIENT_ID": "cinatoken-admin",
		"CINATOKEN_REQUIRED_ROLES": "super_admin,security_admin",
		"ADMIN_COOKIE_SECURE": "true",
		// Admin 无 Next middleware.ts。Workerd 上 getMiddlewareManifest() 的动态 require 会 500；
		// 上游 issue 仍 open 时用 minimal mode 跳过该路径（见 opennextjs-cloudflare#1232）。
		"NEXT_PRIVATE_MINIMAL_MODE": "1"
	}
}

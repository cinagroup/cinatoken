{
	// 模板：由 `npm run gen:wrangler` 生成 `wrangler.jsonc`（勿手改生成文件）。
	// D1 是默认数据面；gen-wrangler 可加入 Hyperdrive，并仅在 DATABASE_DRIVER=postgres 时显式切换。
	// 执行 `npm run db:migrate*` 时使用 `packages/core/wrangler.d1.jsonc`（仅 D1，勿 deploy）。
	// 本地 dev：生成文件应无 database_id（`(DB)` 本地库）。远程 deploy 后会写入 database_id — 继续本地 dev 前须再跑 npm run gen:wrangler。
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cinatoken-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	// 认证失败按调用方限速；公开统计只在缓存未命中时按固定路由键限速。
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "2001",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "PUBLIC_STATS_RATE_LIMITER",
			"namespace_id": "2002",
			"simple": { "limit": 12, "period": 60 }
		},
		{
			"name": "ANALYTICS_RATE_LIMITER",
			"namespace_id": "2003",
			"simple": { "limit": 64, "period": 60 }
		}
	],

	"workers_dev": false,
	"routes": [
		{
			"pattern": "api.cinatoken.com/*",
			"zone_name": "cinatoken.com"
		}
	],
	"vars": {
		"REQUEST_BODY_LOGGING": "off",
		// Phase 2 safety gate: infrastructure can be staged while the public API remains unavailable.
		"BATCH_API_ENABLED": "false",
		"PROVIDER_ATTEMPT_RETENTION_DAYS": "7",
		"PROVIDER_ATTEMPT_RETENTION_BATCH_SIZE": "5000",
		"PROVIDER_ATTEMPT_RETENTION_MAX_BATCHES": "10"
	},
	"triggers": {
		// UTC: hourly at minute 17; each invocation remains bounded to 50,000 rows.
		"crons": ["17 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cinatoken",
			"migrations_dir": "../core/migrations-d1"
		}
	],
	// gen-wrangler removes all Batch bindings unless BATCH_INFRA_ENABLED=true.
	"r2_buckets": [
		{
			"binding": "BATCH_BUCKET",
			"bucket_name": "cinatoken-batch-private"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "BATCH_QUEUE",
				"queue": "cinatoken-batch-jobs"
			}
		],
		"consumers": [
			{
				"queue": "cinatoken-batch-jobs",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 8,
				"retry_delay": 30,
				"dead_letter_queue": "cinatoken-batch-jobs-dlq",
				"max_concurrency": 5
			},
			{
				"queue": "cinatoken-batch-jobs-dlq",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 0,
				"max_concurrency": 1
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"secrets": {
		"required": ["SHARED_KEY_ENCRYPTION_SECRET", "DEEPSEEK_API_KEY"]
	}
}

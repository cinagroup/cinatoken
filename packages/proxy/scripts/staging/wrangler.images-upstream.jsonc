{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "cinatoken-staging-images-upstream",
  "main": "images-upstream.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": [] },
  "limits": { "cpu_ms": 1000 },
  "d1_databases": [{ "binding": "PROBE_DB", "database_name": "cinatoken-staging", "database_id": "6bf5d41e-fe0b-4afa-9f67-ff5cf82e23d1" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "send_metrics": false
}

{
  // Standalone staging source. Do not merge with wrangler.base.jsonc or run
  // the production instance generator. Use prepare-proxy-staging.mjs.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinatoken-proxy-staging",
  "main": "src/index.ts",
  // Match the existing production-source compatibility contract.
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "send_metrics": false,
  // Keep all ingress closed until Access protection is separately verified.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": [] },
  "vars": {
    "DATABASE_DRIVER": "d1",
    "REQUEST_BODY_LOGGING": "off",
    "BATCH_API_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinatoken-staging",
      "migrations_dir": "../core/migrations-d1"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "60002001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUBLIC_STATS_RATE_LIMITER", "namespace_id": "60002002", "simple": { "limit": 12, "period": 60 } },
    { "name": "ANALYTICS_RATE_LIMITER", "namespace_id": "60002003", "simple": { "limit": 64, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Fresh staging-only material, never copied from production. No provider key.
  "secrets": { "required": ["SHARED_KEY_ENCRYPTION_SECRET"] }
}

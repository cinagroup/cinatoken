import upstream from "../data/updates/upstream-index.json";
import local from "../data/updates/cinatoken.json";
const zh = Astro.locals.starlightRoute.lang.startsWith("zh"),
	locale = zh ? "zh" : "en";
const rows = [...local.items, ...upstream.items].sort(
	(a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id),
);
const copy = zh
	? {
			query: "搜索更新",
			source: "来源",
			all: "全部来源",
			previous: "上一页",
			next: "下一页",
			status: "{n} 条记录 · 第 {page}/{pages} 页",
			empty: "没有匹配的更新。",
			article: "阅读更新",
			evidence: "来源记录",
		}
	: {
			query: "Search updates",
			source: "Source",
			all: "All sources",
			previous: "Previous",
			next: "Next",
			status: "Entries: {n} · Page {page}/{pages}",
			empty: "No matching updates.",
			article: "Read update",
			evidence: "Source record",
		};
---

<section
	data-filter-list
	data-page-size="10"
	data-filter-param="source"
	data-copy={JSON.stringify(copy)}
>
	<p class="notice">
		{
			zh
				? "CinaToken 更新记录托管平台的实际变更。OctaFuse 条目是上游历史索引，日期按原文记录，保留项目身份与原文链接；不表示对应版本已部署到 CinaToken。"
				: "CinaToken updates describe changes to this hosted platform. OctaFuse entries index upstream history, retain dates recorded by the original articles and link to their source. They do not indicate deployment on CinaToken."
		}
	</p>
	<div class="filters">
		<label
			>{copy.query}<input type="search" data-catalog-query disabled /></label
		><label
			>{copy.source}<select data-catalog-vendor disabled
				><option value="">{copy.all}</option><option value="cinatoken"
					>CinaToken</option
				><option value="octafuse">OctaFuse Gateway</option></select
			></label
		>
	</div>
	<p role="status" aria-live="polite" data-catalog-status>
		{rows.length}
		{zh ? "条记录" : "entries"}
	</p>
	{
		rows.map((row) => (
			<article
				data-catalog-row
				data-vendor={row.source}
				data-search={`${row.title[locale]} ${row.source} ${row.date}`.toLowerCase()}
			>
				<p class="meta">
					<time datetime={row.date}>{row.date} UTC</time> ·{" "}
					<strong>
						{row.source === "cinatoken" ? "CinaToken" : "OctaFuse Gateway"}
					</strong>
				</p>
				<h2>
					<a href={row.href[locale]}>{row.title[locale]}</a>
				</h2>
				<p>
					<a href={row.href[locale]}>
						{copy.article}
						{row.source === "octafuse" ? " ↗" : ""}
					</a>{" "}
					· <a href={row.evidence}>{copy.evidence}</a>
				</p>
			</article>
		))
	}
	<nav aria-label={zh ? "更新分页" : "Updates pagination"}>
		<button data-catalog-previous type="button" disabled>{copy.previous}</button
		><button data-catalog-next type="button" disabled>{copy.next}</button>
	</nav>
</section>
<script>
	import "../scripts/filter-list";
</script>
<style>
	.notice {
		border-inline-start: 3px solid var(--sl-color-accent);
		padding: 1rem;
		background: var(--sl-color-accent-low);
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-block: 1.5rem;
	}
	.filters label {
		display: grid;
		gap: 0.4rem;
		flex: 1 1 12rem;
		min-width: 0;
		margin: 0;
	}
	input,
	select {
		width: 100%;
		min-width: 0;
		margin: 0;
		box-sizing: border-box;
	}
	input,
	select,
	button {
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.375rem;
		padding: 0.6rem;
		color: var(--sl-color-text);
		background: var(--sl-color-bg);
		font: inherit;
	}
	article {
		padding: 1.25rem 0;
		border-top: 1px solid var(--sl-color-gray-5);
	}
	h2 {
		font-size: 1.25rem;
		margin: 0.4rem 0;
	}
	p.meta {
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		margin: 0;
	}
	nav {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
	}
	button:disabled {
		opacity: 0.45;
	}
	[hidden] {
		display: none !important;
	}
</style>

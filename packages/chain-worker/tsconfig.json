{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "WebWorker", "DOM.Iterable"],
		"types": ["@cloudflare/workers-types", "node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "worker-configuration.d.ts"]
}

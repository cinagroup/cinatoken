{
	"name": "@octafuse/core",
	"version": "2.8.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"bin": {
		"octafuse-migrate": "./dist/migrate/cli.js"
	},
	"scripts": {
		"prebuild": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
		"build": "npm run build:migrate && npm run build:node-index",
		"build:migrate": "tsc -p tsconfig.build.migrate.json",
		"build:node-index": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --log-level=warning",
		"pretest:unit": "npm run test:ordinary-budget -w @octafuse/core && npm run test:workspaces -w @octafuse/core && npm run test:generation-lookup -w @octafuse/core && npm run test:model-endpoints -w @octafuse/core && npm run test:management-keys -w @octafuse/core && npm run test:key-expiry -w @octafuse/core && npm run test:key-limits -w @octafuse/core && npm run test:availability -w @octafuse/core && npm run test:batches -w @octafuse/core",
		"test:ordinary-budget": "tsx --test src/storage/api-key-auth.d1.test.ts src/storage/user-budget-spent-micros-migration.d1.test.ts src/storage/user-budget.d1.test.ts src/storage/user-budget-critical-write.d1.test.ts",
		"test:workspaces": "tsx --test src/storage/workspaces.d1.test.ts src/storage/workspaces.postgres.test.ts src/storage/preset-guardrail-workspaces.d1.test.ts src/storage/management-workspaces.d1.test.ts src/storage/workspace-budget-usage.d1.test.ts src/storage/workspace-budget-usage.sql-contract.test.ts",
		"test:generation-lookup": "tsx --test src/db/request-logs-generation-lookup.contract.test.ts src/db/request-logs-generation-feedback.contract.test.ts",
		"test:model-endpoints": "tsx --test src/model-endpoint-catalog.test.ts src/model-endpoint-runtime.test.ts src/model-endpoint-backfill.test.ts src/storage/model-endpoints.sql-repositories.test.ts",
		"test:management-keys": "tsx --test src/storage/management-api-keys.d1.test.ts src/storage/management-gateway-keys.d1.test.ts src/storage/byok-keys.d1.test.ts src/storage/byok-keys.sql-contract.test.ts src/db/byok-keys-types.test.ts src/db/management-gateway-keys-usage.contract.test.ts",
		"test:key-expiry": "tsx --test src/services/key-service.test.ts src/storage/api-key-auth.d1.test.ts",
		"test:key-limits": "tsx --test src/gateway-key-limits.test.ts src/workspace-budgets.test.ts",
		"test:availability": "tsx --test src/db/provider-attempt-availability.test.ts",
		"test:batches": "tsx --test src/db/batch-types.test.ts src/storage/batches.d1.test.ts src/storage/batches.sql-contract.test.ts",
		"test:unit": "tsx --test src/storage/drizzle/client-postgres.test.ts src/storage/organization-identity.d1.test.ts src/storage/guardrail-budget.d1.test.ts src/storage/route-data-policy-subject.d1.test.ts src/storage/model-endpoints.d1.test.ts src/storage/request-session-id-migration.d1.test.ts src/request-presets.test.ts src/guardrails.test.ts src/route-comparable-price.test.ts src/route-performance.test.ts src/route-planner-preview.test.ts src/public-model-catalog.test.ts src/route-data-policy.test.ts src/organization-identity.test.ts src/chain-jobs.test.ts src/db/admin-access-key-mutation.test.ts src/db/guardrail-assignment-policy.test.ts src/db/model-routing-embeddings.contract.test.ts src/db/request-logs-user-stats.d1.test.ts src/db/request-activity-groups.contract.test.ts src/db/analytics-query.d1.test.ts src/db/route-performance-sampling.test.ts src/db/image-token-usage.test.ts src/db/audio-token-usage.test.ts src/db/image-per-image-usage.test.ts src/db/pricing-profile.test.ts src/db/pricing-schedule.test.ts src/db/user-charged-cost-factors.test.ts src/db/model-modalities.test.ts src/db/model-route-policy.test.ts src/db/route-routing-metadata.test.ts src/db/postgres/model-route-patch.test.ts src/db/postgres/model-routes.test.ts src/db/route-pool-tier-strategies.test.ts src/db/route-pool-sticky-types.test.ts src/db/route-pool-sticky-bindings.contract.test.ts src/db/public-model-daily-stats.test.ts src/db/public-model-daily-stats-write.contract.test.ts src/lib/business-timezone.test.ts src/lib/shared-key-encryption.test.ts src/lib/provider-key-encryption.test.ts src/lib/provider-key-environment.test.ts src/lib/key-hash.test.ts src/lib/public-model-slug.test.ts src/services/budget-transition-service.test.ts src/services/user-plan-patch-service.test.ts src/storage/runtime-database-config.test.ts src/upstream-protocol-images-url.test.ts src/provider-endpoints.test.ts src/route-topology.test.ts src/realtime-protocol.test.ts src/gcp-service-account-token.test.ts src/vertex-openai-model.test.ts"
	},
	"files": [
		"dist",
		"migrations-d1",
		"migrations-postgres",
		"migrations-mysql",
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"node": "./dist/index.js",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./db/pricing-profile": "./src/db/pricing-profile.ts",
		"./db/image-token-usage": "./src/db/image-token-usage.ts",
		"./db/audio-token-usage": "./src/db/audio-token-usage.ts",
		"./db/pricing-schedule": "./src/db/pricing-schedule.ts",
		"./db/model-modalities": "./src/db/model-modalities.ts",
		"./db/model-route-policy": "./src/db/model-route-policy.ts",
		"./db/route-pool-tier-strategies": "./src/db/route-pool-tier-strategies.ts",
		"./db/route-pool-sticky-types": "./src/db/route-pool-sticky-types.ts",
		"./db/route-affinity-key": "./src/db/route-affinity-key.ts",
		"./db/provider-key-utils": "./src/db/provider-key-utils.ts",
		"./db/request-log-status-filter": "./src/db/request-log-status-filter.ts",
		"./db/user-audit-catalog": "./src/db/user-audit-catalog.ts",
		"./db/user-budget-audit-params": "./src/db/user-budget-audit-params.ts",
		"./db/user-budget-audit-mapper": "./src/db/user-budget-audit-mapper.ts",
		"./db/user-audit-log-derived": "./src/db/user-audit-log-derived.ts",
		"./db/user-audit-metadata": "./src/db/user-audit-metadata.ts",
		"./db/user-audit-snapshot": "./src/db/user-audit-snapshot.ts",
		"./db/users-list-sort": "./src/db/users-list-sort.ts",
		"./db/api-keys-list-sort": "./src/db/api-keys-list-sort.ts",
		"./model-endpoint-catalog": "./src/model-endpoint-catalog.ts",
		"./public-model-catalog": "./src/public-model-catalog.ts",
		"./lib/business-timezone": "./src/lib/business-timezone.ts",
		"./lib/billing-currency": "./src/lib/billing-currency.ts",
		"./lib/public-model-slug": "./src/lib/public-model-slug.ts",
		"./lib/alert-webhook-system-config": "./src/lib/alert-webhook-system-config.ts",
		"./lib/web-search-system-config": "./src/lib/web-search-system-config.ts",
		"./lib/web-fetch-system-config": "./src/lib/web-fetch-system-config.ts",
		"./lib/web-deep-search-system-config": "./src/lib/web-deep-search-system-config.ts",
		"./lib/ai-detection-system-config": "./src/lib/ai-detection-system-config.ts",
		"./lib/tool-pricing": "./src/lib/tool-pricing.ts",
		"./lib/route-strategy-system-config": "./src/lib/route-strategy-system-config.ts",
		"./lib/money-precision": "./src/lib/money-precision.ts",
		"./lib/string-utils": "./src/lib/string-utils.ts",
		"./lib/time-format": "./src/lib/time-format.ts",
		"./services/key-service": "./src/services/key-service.ts",
		"./services/user-service": "./src/services/user-service.ts",
		"./services/budget-transition-service": "./src/services/budget-transition-service.ts",
		"./services/user-plan-patch-service": "./src/services/user-plan-patch-service.ts",
		"./storage/drizzle/client-d1": "./src/storage/drizzle/client-d1.ts",
		"./storage/repositories-d1": "./src/storage/repositories-d1.ts",
		"./storage/runtime-database-config": "./src/storage/runtime-database-config.ts",
		"./storage/context": "./src/storage/context.ts",
		"./storage/organization-identity": "./src/storage/organization-identity.ts",
		"./upstream-protocol": "./src/upstream-protocol.ts",
		"./provider-endpoints": "./src/provider-endpoints.ts",
		"./route-topology": "./src/route-topology.ts",
		"./realtime-protocol": "./src/realtime-protocol.ts",
		"./gemini-upstream-url": "./src/gemini-upstream-url.ts",
		"./gcp-service-account-token": "./src/gcp-service-account-token.ts",
		"./vertex-openai-model": "./src/vertex-openai-model.ts",
		"./services/shared-key-earnings": "./src/services/shared-key-earnings.ts"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"mysql2": "^3.22.0",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260829.1",
		"@types/node": "^25.5.0",
		"esbuild": "^0.27.3",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2"
	}
}

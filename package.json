{
	"name": "cinatoken",
	"version": "2.9.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/cinagroup/cinatoken.git"
	},
	"type": "module",
	"workspaces": [
		".",
		"packages/core",
		"packages/tool-engines",
		"packages/proxy",
		"packages/admin",
		"packages/chain-worker"
	],
	"scripts": {
		"postinstall": "npm run gen:wrangler",
		"gen:wrangler": "node scripts/deploy/gen-wrangler.mjs",
		"verify:package-versions": "node scripts/ci/verify-package-versions.mjs",
		"ci:changeset-tag-push": "changeset tag && node scripts/ci/push-root-release-tag.mjs",
		"release:notes": "node scripts/release/render-release-notes.mjs",
		"dev:proxy": "npm run dev -w @octafuse/proxy",
		"dev:proxy:node": "dotenv -c -- npm run dev:node -w @octafuse/proxy",
		"dev:admin": "npm run preview -w @octafuse/admin",
		"dev:admin:node": "dotenv -c -- npm run dev:node -w @octafuse/admin",
		"deploy:proxy": "npm run gen:wrangler -- --remote && npm run deploy -w @octafuse/proxy",
		"deploy:admin": "npm run build -w @octafuse/core && npm run gen:wrangler -- --remote && npm run deploy -w @octafuse/admin",
		"deploy:chain": "npm run build -w @octafuse/core && npm run gen:wrangler -- --remote && npm run deploy -w @cinatoken/chain-worker",
		"preflight:chain": "npm run preflight:contracts -w @cinatoken/chain-worker --",
		"bootstrap:cloudflare": "node scripts/deploy/bootstrap-cloudflare.mjs",
		"deploy:cloudflare": "node scripts/deploy/deploy-instance.mjs",
		"db:migrate": "npm run gen:wrangler && node scripts/deploy/wrangler-d1-cli.mjs migrations apply --local --persist-to .wrangler/state",
		"db:migrate:remote": "npm run gen:wrangler -- --remote && node scripts/deploy/wrangler-d1-cli.mjs migrations apply --remote",
		"db:migrate:pg": "dotenv -c -- tsx packages/core/src/migrate/cli.ts --driver postgres",
		"db:migrate:pg:docker": "node packages/core/dist/migrate/cli.js --driver postgres",
		"db:provision:pg-roles": "dotenv -c -- tsx scripts/db/cutover/provision-postgres-roles.ts",
		"db:grant:pg-runtime": "dotenv -c -- tsx scripts/db/cutover/grant-postgres-runtime.ts",
		"db:preflight:d1-source": "tsx scripts/db/cutover/preflight-d1-source.ts --d1-source=remote",
		"db:endpoint-backfill:plan": "tsx scripts/db/model-endpoints/cli.ts plan",
		"db:endpoint-backfill:apply": "tsx scripts/db/model-endpoints/cli.ts apply",
		"db:migrate:mysql": "dotenv -c -- tsx packages/core/src/migrate/cli.ts --driver mysql",
		"db:migrate:mysql:docker": "node packages/core/dist/migrate/cli.js --driver mysql",
		"db:list:pg": "dotenv -c -- tsx scripts/db/diag/list-pg-databases.ts",
		"predb:retention:provider-attempts": "npm run build:node-index -w @octafuse/core",
		"db:retention:provider-attempts": "dotenv -c -- tsx scripts/db/maintenance/provider-attempt-retention.ts",
		"db:query": "npm run gen:wrangler && node scripts/deploy/wrangler-d1-cli.mjs execute --local --persist-to .wrangler/state --command",
		"db:query:remote": "npm run gen:wrangler -- --remote && node scripts/deploy/wrangler-d1-cli.mjs execute --remote --command",
		"db:export:remote:schema": "tsx scripts/db/d1-remote-export/export-remote-schema.ts",
		"db:export:remote:data": "tsx scripts/db/d1-remote-export/export-remote-data.ts",
		"test:gateway:node-smoke": "dotenv -c -- tsx scripts/smoke/test-node-core-routes.ts",
		"test:gateway:postgres-smoke": "dotenv -c -- tsx scripts/smoke/test-postgres-core-routes.ts",
		"test:gateway:sql-storage-smoke": "dotenv -c -- tsx scripts/smoke/test-storage-concurrent-charge.ts",
		"test:public-catalog-readiness": "tsx scripts/smoke/test-public-catalog-readiness.ts",
		"test:public-catalog-readiness:contract": "tsx --test scripts/smoke/test-public-catalog-readiness.test.ts",
		"test:deploy": "node --test scripts/deploy/*.test.mjs",
		"verify:proxy-bundle": "node scripts/ci/verify-proxy-bundle-externals.mjs",
		"test:d1-portal-ledger": "node scripts/ci/verify-d1-portal-ledger.mjs",
		"test:postgres-migration": "node scripts/ci/verify-postgres-migration-contract.mjs",
		"test:mysql-migration": "node scripts/ci/verify-mysql-migration-contract.mjs",
		"test:endpoint-backfill-plan": "tsx --test scripts/db/model-endpoints/*.test.ts",
		"test:postgres-role-provisioning": "tsx --test scripts/db/cutover/postgres-role-provisioning.test.ts scripts/db/cutover/diagnostic-auth.test.ts scripts/db/cutover/preflight-d1-source.test.ts scripts/db/cutover/hyperdrive-bootstrap-worker.test.ts",
		"test:unit": "npm run test:deploy && npm run test:d1-portal-ledger && npm run test:postgres-migration && npm run test:mysql-migration && npm run test:endpoint-backfill-plan && npm run test:public-catalog-readiness:contract && npm run test:postgres-role-provisioning && npm run test:unit -w @octafuse/core && npm run test:unit -w @octafuse/tool-engines && npm run test:unit -w @octafuse/proxy && npm run test:unit -w @octafuse/admin && npm run test:unit -w @cinatoken/chain-worker"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.8",
		"@types/node": "^25.5.0",
		"dotenv-cli": "^11.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.7.2",
		"wrangler": "^4.127.1"
	}
}

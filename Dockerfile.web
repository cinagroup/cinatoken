# Build from repository root with WEB_RELEASE_PATH=.release/web/<release-id>.
# This image only provides the progressive entry;
# run the existing Admin image alongside it on the same Docker network.
ARG NODE_IMAGE=node:22-alpine3.22@sha256:b77017c37f430e4466ff497058948a2f16e8b59779600d53711eeb7b999b0f4e
ARG NGINX_IMAGE=nginx:stable-alpine

FROM ${NODE_IMAGE} AS verifier
WORKDIR /app
COPY packages/web/scripts/package-release.mjs packages/web/scripts/asset-policy.mjs packages/web/scripts/build-contract.mjs packages/web/scripts/build-inputs.mjs packages/web/scripts/source-archive.mjs packages/web/scripts/source-delivery.mjs packages/web/scripts/historical-source.mjs ./packages/web/scripts/
ARG WEB_RELEASE_PATH=.release/web/__required_explicit_id__
COPY ${WEB_RELEASE_PATH}/ ./.release/web/input/
# The build context directory is an explicit alias; manifest identity is retained.
RUN node packages/web/scripts/package-release.mjs --verify-artifact input

FROM ${NGINX_IMAGE} AS runner
COPY --from=verifier /app/.release/web/input/assets /usr/share/nginx/html
# Evidence files stay outside the public root.
COPY --from=verifier /app/.release/web/input/manifest.json /app/.release/web/input/manifest.sha256 /usr/share/web-release/
COPY docker/web/nginx.conf.template /etc/nginx/web-entry.conf.template
COPY docker/web/admin-proxy.conf /etc/nginx/web-admin-proxy.conf
COPY docker/web/entrypoint.sh /web-entrypoint.sh
RUN chmod +x /web-entrypoint.sh
ENV CINATOKEN_WEB_PUBLIC_ENABLED=false
ENV CINATOKEN_WEB_SSR_UPSTREAM=http://gateway-web-ssr:8791
ENV CINATOKEN_WEB_ACCOUNT_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_DASHBOARD_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_USERS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_USER_DETAIL_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_PROVIDERS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_MODELS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_ENDPOINTS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_ROUTES_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_DATA_POLICIES_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_PRESETS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_GUARDRAILS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_RELIABILITY_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_MODEL_ANALYTICS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_PROVIDER_ANALYTICS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_USER_ANALYTICS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_REQUEST_LOGS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_BUDGET_AUDIT_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_TOOL_INVOCATIONS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_CONFIG_TIMEZONE_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_CONFIG_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_ACCESS_KEYS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_KEYS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_SHARED_KEYS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_TOOLS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_PLAYGROUND_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_SIMULATOR_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_WITHDRAWALS_ENABLED=false
ENV CINATOKEN_WEB_ADMIN_NFT_MINTS_ENABLED=false
ENV CINATOKEN_WEB_PROXY_ORIGINS=""
ENV CINATOKEN_ADMIN_UPSTREAM=http://admin:8789
EXPOSE 8080
ENTRYPOINT ["/web-entrypoint.sh"]

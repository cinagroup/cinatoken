# =============================================================================
# cinatoken Gateway — 公共演示 / 长期测试实例模板
# =============================================================================
# 文档入口：同目录 README.md · 运维：docs/operators/deployment/cloudflare.md
#
# 本文件即 dev 演示 canonical 配置（可提交 Git）。
# 自有生产环境：复制为 cloudflare-worker/<name>.env（gitignore），部署说明写在对应 env 注释里。
#
# 本地 CLI：
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run db:migrate:remote
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run deploy:proxy
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run deploy:admin
#
# 生产 Git 自动部署见 README §C（dev 演示仅 CLI 发版）
#
# 测试域名（请替换为本 Cloudflare 账号中的自有 zone）：
#   Proxy   https://api.example.com
#   Admin   https://admin.example.com
#
# 下游测试用户：
#   GATEWAY_URL=https://api.example.com
#   GATEWAY_MASTER_URL=https://admin.example.com
#   GATEWAY_MASTER_KEY=<D1 system_config.MASTER_KEY>
#
# 首次：npx wrangler d1 create cinatoken-dev → 填入 D1_DATABASE_ID

PROXY_WORKER_NAME=cinatoken-proxy-dev
ADMIN_WORKER_NAME=cinatoken-admin-dev

D1_DATABASE_NAME=cinatoken-dev
D1_DATABASE_ID=e4b8a39b-f369-42e4-bdc2-b603d3f81f5f
# 仅 wrangler d1 migrations 配置名；勿 deploy，无需在 Dashboard 建 Worker
D1_MIGRATIONS_WORKER_NAME=cinatoken-d1-migrations-dev

PROXY_CUSTOM_DOMAIN=api.example.com
ADMIN_CUSTOM_DOMAIN=admin.example.com

frozen-data-binding.mjs
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
const originals=JSON.parse(fs.readFileSync(new URL('./frozen-data-original-pins-v3.json',import.meta.url),'utf8'));
const safe=n=>typeof n==='string'&&n!==''&&!path.isAbsolute(n)&&!n.includes('\\')&&!n.split('/').some(p=>p===''||p==='.'||p==='..'||/[:\x00-\x1f]/u.test(p));
const exact=(item,pin)=>{assert.ok(item,'Pinned original file missing');assert.equal(item.bytes.length,pin.bytes);assert.equal(item.sha256,pin.sha256);return item;};
const times=v=>{assert.ok(Number.isFinite(Date.parse(v.at))&&Number.isFinite(Date.parse(v.finishedAt)));assert.ok(Date.parse(v.finishedAt)>=Date.parse(v.at));};
const registration=(b,kind)=>{const r=originals.bindings.find(x=>x.kind===kind&&x.rootId===b.rootId&&(x.reportFile??x.file)===(b.reportFile??b.file));assert.ok(r,'Unknown data binding');assert.deepEqual(b,r,'Data binding differs from exact original pins');return r;};
const sourceContext=(b,contexts)=>{const c=contexts.find(x=>x.input.id===b.rootId);assert.ok(c);assert.equal(path.resolve(c.root),path.resolve(b.sourceRoot));return c;};
const producer=(b,c)=>exact(c.data.get(path.basename(b.producer.file)),b.producer);
const pinnedCommand=(c,pin,expectedActualExit=0)=>{assert.ok([0,1].includes(expectedActualExit));const name=path.basename(pin.file),item=exact(c.data.get(name),pin),v=c.json.get(name),a=c.receiptByName.get(name);assert.deepEqual(v,JSON.parse(item.bytes));assert.ok(a&&a.actualExit===expectedActualExit&&a.signal===null&&a.spawnError===null);assert.equal(a.sha256,item.sha256);assert.equal(v.actualExit,expectedActualExit);assert.ok(typeof v.executable==='string'&&Array.isArray(v.args));times(v);for(const stream of ['stdout','stderr']){const full=typeof v[stream]==='string'?v[stream]:v[stream].path,descriptor=typeof v[stream]==='string'?v[stream+'Info']:v[stream],rel=path.relative(c.root,full).split(path.sep).join('/');assert.ok(safe(rel));const output=exact(c.data.get(rel),descriptor);assert.ok(output.mtimeMs<=item.mtimeMs);}return{value:v,item};};
export function validateFrozenDataBinding(b,contexts){
 if(b.kind==='exact-file-read-report-only-v1'){
  registration(b,b.kind);const c=sourceContext(b,contexts),item=exact(c.data.get(b.reportFile),{bytes:b.reportBytes,sha256:b.reportSha256}),v=c.json.get(b.reportFile);
  assert.deepEqual(v,b.report);producer(b,c);times(v);
  assert.deepEqual(Object.keys(v).sort(),['at','finishedAt','operation','path','actualExit','signal','error','stdout','stderr'].sort());
  assert.equal(v.operation,'readFile');assert.ok(path.isAbsolute(v.path));assert.equal(v.signal,null);assert.ok(v.actualExit===0||v.actualExit===null);
  assert.equal(b.outputs.length,2);const names=[];
  for(const [i,stream]of ['stdout','stderr'].entries()){const d=b.outputs[i];assert.equal(d.stream,stream);assert.ok(safe(d.file));assert.equal(path.resolve(v[stream].path),path.resolve(c.root,d.file));assert.deepEqual({bytes:v[stream].bytes,sha256:v[stream].sha256},{bytes:d.bytes,sha256:d.sha256});exact(c.data.get(d.file),d);names.push(d.file);}
  if(v.actualExit===0){assert.equal(v.error,null);assert.equal(c.data.get(names[1]).bytes.length,0);}else{assert.deepEqual(Object.keys(v.error).sort(),['code','message']);assert.equal(v.error.code,'ENOENT');assert.equal(typeof v.error.message,'string');assert.equal(c.data.get(names[0]).bytes.length,0);assert.deepEqual(c.data.get(names[1]).bytes,Buffer.from(JSON.stringify(v.error)+'\n'));}
  return{context:c,names:[b.reportFile,...names],report:{root:b.rootId,file:b.reportFile,sha256:item.sha256,dialect:b.kind,reportOnly:true,operation:'readFile',observedFileReadStatus:v.actualExit,observedFileReadErrorCode:v.error?.code??null,actualProcessExit:null,actualChildExitProven:false,newExecutionClaimed:false,gatePassDerived:false,sourcePathReported:v.path}};
 }
 if(b.kind==='exact-native-workflow-utf16-slice-v1'){
  registration(b,b.kind);const c=sourceContext(b,contexts);producer(b,c);exact(c.data.get(path.basename(b.report.file)),b.report);
  const source=exact(c.data.get(b.sourceFile),b.source),receiptItem=exact(c.data.get(b.receiptFile),b.receipt),receipt=c.json.get(b.receiptFile),authority=c.receiptByName.get(b.receiptFile);
  assert.ok(authority&&authority.actualExit===0&&authority.signal===null&&authority.spawnError===null);assert.equal(authority.sha256,receiptItem.sha256);assert.deepEqual(receipt.args,['run','view','37412060008','--repo','cinagroup/cinatoken','--job','112102451588','--log']);times(receipt);
  assert.equal(path.resolve(receipt.stdout),path.resolve(c.root,b.sourceFile));assert.deepEqual(receipt.stdoutInfo,{bytes:b.source.bytes,sha256:b.source.sha256});
  assert.ok((c.logs.get(b.sourceFile)??[]).some(x=>x.file===b.receiptFile&&x.sha256===receiptItem.sha256));
  const originalReport=c.json.get(path.basename(b.report.file)),row=originalReport.chain55to113.records.find(x=>x.step===b.step);assert.ok(row?.group);assert.equal(path.basename(row.group.file),b.file);assert.equal(row.workflowCommand,b.workflowCommand);assert.deepEqual({bytes:row.group.bytes,sha256:row.group.sha256,startStringOffset:row.group.startStringOffset,endStringOffset:row.group.endStringOffset},{bytes:b.bytes,sha256:b.sha256,startStringOffset:b.startStringOffset,endStringOffset:b.endStringOffset});
  const sliceProducer=pinnedCommand(c,b.sliceProducerReceipt),progressCommand=pinnedCommand(c,b.progressReceipt);assert.equal(path.resolve(sliceProducer.value.args[0]),path.resolve(b.producer.file));assert.equal(path.resolve(sliceProducer.value.args[1]),path.resolve(c.root));assert.equal(sliceProducer.value.args[2],'proxy-progress-11');assert.equal(sliceProducer.value.args.length,3);assert.equal(progressCommand.value.args[0],'run');assert.equal(progressCommand.value.args[1],'view');assert.equal(progressCommand.value.args[2],'37412060008');assert.equal(progressCommand.value.args[3],'--repo');assert.equal(progressCommand.value.args[4],'cinagroup/cinatoken');const progressItem=exact(c.data.get(path.basename(b.progressFile.file)),b.progressFile),progress=JSON.parse(progressItem.bytes);assert.deepEqual(progress,originalReport.run);assert.equal(progress.databaseId,37412060008);assert.equal(progress.headSha,'dcc6ab52f21a18c5d1c02d8a4a4a390f039e61fc');assert.equal(progress.status,'completed');assert.equal(originalReport.nativeJob.databaseId,112102451588);assert.equal(originalReport.nativeJob.status,'completed');
  const text=source.bytes.toString('utf8');assert.deepEqual(Buffer.from(text,'utf8'),source.bytes,'Original full log must be strict UTF8 roundtrip');assert.ok(Number.isSafeInteger(b.startStringOffset)&&Number.isSafeInteger(b.endStringOffset)&&b.startStringOffset>=0&&b.endStringOffset>b.startStringOffset&&b.endStringOffset<=text.length);

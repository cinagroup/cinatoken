 const downloadItem=exact(c.data.get(b.downloadFile),b.download),d=c.json.get(b.downloadFile),da=c.receiptByName.get(b.downloadFile);assert.deepEqual(d,b.downloadBody);assert.ok(da&&da.actualExit===0&&da.signal===null&&da.spawnError===null);assert.equal(da.sha256,downloadItem.sha256);times(d);
 assert.equal(d.executable,'C:/Program Files/GitHub CLI/gh.exe');assert.equal(d.args[0],'run');assert.equal(d.args[1],'download');assert.equal(d.args[2],b.runId);assert.equal(d.args[3],'--repo');assert.equal(d.args[4],'cinagroup/cinatoken');assert.equal(d.args[5],'--name');assert.equal(d.args[6],`v364-direct-socket-${b.sourceSHA}-${b.runId}-${b.runAttempt}`);assert.equal(d.args[7],'--dir');assert.equal(d.args.length,9);
 const artifactRoot=b.executorFile.split('/')[0];assert.equal(path.resolve(d.args[8]),path.resolve(c.root,artifactRoot));
 for(const stream of ['stdout','stderr']){const output=d[stream];assert.ok(output&&path.isAbsolute(output.path));const name=path.relative(c.root,output.path).split(path.sep).join('/');assert.ok(safe(name));const raw=exact(c.data.get(name),output);assert.ok(raw.mtimeMs<=downloadItem.mtimeMs);}
 const metaItem=exact(c.data.get(b.metadataFile),b.metadata),metadata=JSON.parse(metaItem.bytes),metaCommand=pinnedCommand(c,b.metadataReceipt),mr=metaCommand.value;assert.equal(mr.executable,'C:/Program Files/GitHub CLI/gh.exe');assert.deepEqual(mr.args,['api',`repos/cinagroup/cinatoken/actions/runs/${b.runId}/artifacts`]);assert.equal(path.resolve(mr.stdout.path),path.resolve(c.root,b.metadataFile));assert.equal(mr.stdout.bytes,b.metadata.bytes);assert.equal(mr.stdout.sha256,b.metadata.sha256);
 assert.equal(metadata.total_count,1);assert.equal(metadata.artifacts.length,1);const artifact=metadata.artifacts[0];assert.equal(artifact.id,b.artifactId);assert.equal(artifact.name,d.args[6]);assert.equal(String(artifact.workflow_run.id),b.runId);assert.equal(artifact.workflow_run.head_sha,b.sourceSHA);assert.equal(artifact.expired,false);
 assert.equal(v.checkoutSHA,b.sourceSHA);assert.equal(v.run.GITHUB_SHA,b.sourceSHA);assert.equal(v.run.GITHUB_RUN_ID,b.runId);assert.equal(v.run.GITHUB_RUN_ATTEMPT,b.runAttempt);
 const ic=contexts.find(x=>x.input.id===b.indexRootId);assert.ok(ic);assert.equal(path.resolve(ic.root),path.resolve(b.indexSourceRoot));const indexItem=exact(ic.data.get(b.indexFile),b.index);assert.equal(indexItem.sha256,'cedbf58fb411c7a183c60d183f6d36da8c853236ec7711f0b3ad679da2c2f467');const index=ic.json.get(b.indexFile);assert.equal(index.files,981);assert.equal(index.totalBytes,11305947);assert.equal(path.resolve(index.sourceRoot),path.resolve(c.root));
 const entries=new Map(index.entries.map(e=>[e.file,e]));assert.equal(entries.size,981);const prefix=path.posix.dirname(b.executorFile)+'/';
 for(const name of [b.executorFile,...v.files.map(f=>prefix+f.path),b.downloadFile,b.metadataFile,b.metadataReceiptFile]){const item=c.data.get(name),e=entries.get(name);assert.ok(e,'Transported artifact not in externally frozen index');exact(item,e);assert.equal(item.mtimeMs,e.mtimeMs);assert.equal(path.resolve(e.originalPath),path.resolve(c.root,name));}
 return{root:b.rootId,file:b.executorFile,sha256:executorItem.sha256,dialect:b.kind,transportBindingVerified:true,originalMtimePreserved:false,downloadedMtimeIsNotProducerMtime:true,downloadActualExit:0,originalExecutorActualExit:1,originalActualProcessExit:1,originalRunnerOutcomeCode:1,sourceSHA:b.sourceSHA,runId:b.runId,runAttempt:b.runAttempt,artifactId:b.artifactId,frozenIndexSha256:indexItem.sha256,remoteZipDigestReportedOnly:artifact.digest,localZipDigestVerified:false,newExecutionClaimed:false,gatePassDerived:false};
}


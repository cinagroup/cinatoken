name: Proxy dispatch safety

on:
  pull_request:
    paths:
      - 'packages/core/**'
      - 'packages/proxy/**'
      - 'packages/admin/**'
      - 'packages/tool-engines/**'
      - 'scripts/deploy/**'
      - 'scripts/db/cutover/**'
      - 'scripts/db/lib/**'
      - 'scripts/ci/verify-d1-portal-ledger.mjs'
      - 'scripts/ci/verify-mysql-migration-contract.mjs'
      - 'scripts/ci/verify-postgres-migration-contract.mjs'
      - 'package.json'
      - 'package-lock.json'
      - 'tsconfig.base.json'
      - 'tsconfig.json'
      - '.nvmrc'
      - '.github/workflows/proxy-dispatch-safety.yml'
  push:
    branches: [main, develop]
    paths:
      - 'packages/core/**'
      - 'packages/proxy/**'
      - 'packages/admin/**'
      - 'packages/tool-engines/**'
      - 'scripts/deploy/**'
      - 'scripts/db/cutover/**'
      - 'scripts/db/lib/**'
      - 'scripts/ci/verify-d1-portal-ledger.mjs'
      - 'scripts/ci/verify-mysql-migration-contract.mjs'
      - 'scripts/ci/verify-postgres-migration-contract.mjs'
      - 'package.json'
      - 'package-lock.json'
      - 'tsconfig.base.json'
      - 'tsconfig.json'
      - '.nvmrc'
      - '.github/workflows/proxy-dispatch-safety.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: proxy-dispatch-safety-${{ github.ref }}
  cancel-in-progress: true

jobs:
  config-cutover-contracts:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: '.nvmrc'
          cache: npm
      - run: npm ci --ignore-scripts
      - run: npm run build:node-index -w @octafuse/core
      - run: npx tsc -p tsconfig.json --noEmit --pretty false
      - run: npx tsx --test scripts/db/lib/config-cutover-reconcile.test.ts scripts/db/cutover/preflight-d1-source.test.ts
      - run: npm run test:d1-portal-ledger
      - run: npm run test:mysql-migration
      - run: npm run test:postgres-migration

  admin-playground-safety:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: '.nvmrc'
          cache: npm
      - run: npm ci
      - run: npm run build:node-index -w @octafuse/core
      - run: npm run typecheck -w @octafuse/admin
      - run: node --import tsx --test lib/services/admin/users-service.test.ts
        working-directory: packages/admin
      - run: node --import tsx --test lib/routes/admin/earnings.test.ts
        working-directory: packages/admin
      - run: node --import tsx --test lib/routes/shared-key-history-error.test.ts
        working-directory: packages/admin
      - run: node --import tsx --test lib/shared-key-credited-usage-reader.test.ts
        working-directory: packages/admin
      - run: node --import tsx --test lib/shared-key-signed-stats-reader.test.ts
        working-directory: packages/admin
      # Synthetic credentials/transport only; no buyer ledger or real OAuth/model requests.
      - run: npm run test:playground -w @octafuse/admin
  dispatch-safety:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: '.nvmrc'
          cache: npm
      - run: npm ci
      - run: npm run typecheck -w @octafuse/proxy
      - run: npm run typecheck -w @octafuse/tool-engines
      - run: npm run typecheck:shared-key-summary -w @octafuse/core
      - run: npm run typecheck:dispatch-safety -w @octafuse/proxy
      # Synthetic repositories and intercepted fetch only; no cloud credentials.
      - run: npm run test:dispatch-safety -w @octafuse/proxy
      # Local workerd and a loopback provider count physical text POSTs at the transport boundary.
      - run: node --import tsx --test packages/proxy/scripts/staging/text-dispatch-workerd-wire-worker-conditions-successor.test.mjs
      - name: Preserve native Worker transport evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: native-worker-transport-evidence
          path: .wrangler/publish-20260927/workerd-wire-successor/report-*.json
          if-no-files-found: warn
          retention-days: 14
      # A response reset can make an intermediary replay a complete POST behind one Gateway permit.
      - run: node --import tsx --test packages/proxy/scripts/staging/text-dispatch-relay-reset-v376.test.mjs
      # Direct text drivers must stop fallback when a fully uploaded POST loses its response.
      - run: node --import tsx --test packages/proxy/scripts/staging/text-dispatch-response-reset-v377.test.mjs
      # Post-header body resets and a buffering relay expose physical send uncertainty.
      - run: node --import tsx --test packages/proxy/scripts/staging/text-dispatch-post-headers-v385.test.mjs
      - run: node --import tsx --test packages/core/src/storage/shared-key-economic-unsupported-backends.test.mjs
      # Real Node loopback only; ten tool POST drivers must not follow redirects.
      - run: npm run test:unit -w @octafuse/tool-engines
      - run: node --import tsx --test src/services/egress/openai-embeddings-driver.test.ts src/services/egress/openai-rerank-driver.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/shared-key-earnings.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/shared-key-quote-attempt.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/shared-key-economic-usage-handoff.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-ordinary-budget-admission.test.ts src/services/request-budget-admission.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-ordinary-budget-recovery.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-ordinary-budget-request-owner.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/authenticated-chat-budget-proof.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/chat-budget-owner-lifecycle.test.ts src/services/postgres-chat-budget-request-owner.test.ts
        working-directory: packages/proxy
      - run: npm run test:complete-chat-quote -w @octafuse/proxy
      # Two synthetic Workers, a private Service Binding, and an in-process fallback contract.
      - run: node --import tsx --test scripts/staging/chat-holder-binding-v364.node.test.mjs scripts/staging/chat-holder-binding-v364-http-cancel-successor.test.mjs
        working-directory: packages/proxy
      # Review-only Chat quote/admission to private holder seam with one loopback POST.
      - run: node --import tsx --test src/services/complete-chat-holder-dispatch-v385.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-complete-text-no-fetch-close-v388.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-complete-text-no-fetch-recovery-v389.test.ts src/services/hyperdrive-dedicated-role-transport-v390.test.ts src/runtime/complete-text-no-fetch-recovery-worker-v389.test.ts src/runtime/complete-text-holder-worker-v390.test.mjs
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-complete-text-secretless-plan-v391.test.mjs src/services/complete-text-response-observation-v392.test.ts src/services/postgres-complete-text-response-observation-v392.test.ts src/runtime/complete-text-response-holder-worker-v394.test.mjs
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-personal-key-auth-v395.test.mjs src/services/postgres-complete-text-routing-projection-v396.test.ts src/services/credential-free-route-attempts-v398.test.ts src/services/postgres-complete-text-sticky-routing-v398.test.mjs src/services/route-strategies/route-strategies.test.ts src/services/provider-sticky-routing.test.ts src/services/provider-routing-preferences.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/complete-chat-credential-free-dispatch-v400.test.ts
        working-directory: packages/proxy
      # Default-off Hono ingress, actual role-client parsers and owned stream cleanup; synthetic SQL only.
      - run: node --import tsx --test src/services/credential-free-chat-preparation-v401.test.ts src/app-credential-free-chat-ingress-v401.test.ts
        working-directory: packages/proxy
      - run: node --test scripts/db/cutover/build-complete-text-auth-routing-recovery-coinstall-v400.test.mjs
      # Review-only platform no-fetch event delivery; independent LOGIN clients and ACK ownership.
      - run: npm install --prefix .wrangler/v402-pglite-unit --no-save --no-package-lock @electric-sql/pglite@0.5.8
      - run: node --test scripts/db/cutover/build-complete-text-platform-event-delivery-v402.test.mjs scripts/db/cutover/postgres-complete-text-platform-event-delivery-v402.test.mjs scripts/db/cutover/complete-text-platform-event-delivery-runner-v402.test.mjs
        env:
          GATEWAY_PGLITE_MODULE: .wrangler/v402-pglite-unit/node_modules/@electric-sql/pglite/dist/index.js
      - run: node --import tsx --test src/storage/model-endpoints.sql-repositories.test.ts
        working-directory: packages/core
      - run: node --import tsx --test --test-name-pattern="opt-in authenticated Chat budget proof" src/routes/v1/request-dispatch-limit.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test --test-name-pattern="PostgreSQL Chat owner|stopped Chat request|dispatcher sends once after a PostgreSQL owner grant" src/routes/v1/request-dispatch-limit.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-guardrail-budget-admission.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-guardrail-budget-lifecycle-v353.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-guardrail-budget-extension-v355.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/services/postgres-guardrail-budget-request-port-v356.test.ts
        working-directory: packages/proxy
      - run: node --import tsx --test src/runtime/postgres-shared-earning-consumer.test.mjs
        working-directory: packages/proxy
      - run: node --import tsx --test src/runtime/postgres-shared-earning-delivery.test.mjs
        working-directory: packages/proxy
      - run: node --import tsx --test src/runtime/postgres-shared-earning-scanner.test.mjs
        working-directory: packages/proxy
      - run: npm run test:postgres-recovery-composition -w @octafuse/proxy
      - run: npm run test:postgres-recovery-queue-owner -w @octafuse/proxy
      - run: node --test scripts/deploy/gen-wrangler.test.mjs
      - run: node --test scripts/deploy/gen-shared-earning-scanner-wrangler.test.mjs
      - run: node --import tsx --test scripts/db/cutover/build-financial-consumer-direct-login-grant.test.ts
      - run: node --import tsx --test scripts/db/cutover/build-shared-key-usage-repair-direct-login-grant.test.ts
      - run: node --test scripts/db/cutover/openrouter-generation-cost-candidate-v372.test.mjs
      - run: node --test scripts/db/cutover/build-postgres-shared-usage-repair-backfill.test.mjs
      - run: node --test scripts/db/cutover/build-postgres-shared-usage-repair-durable-cursor.test.mjs
      - run: node --test scripts/db/cutover/build-postgres-recovery-retention-review.test.mjs
      - run: node --import tsx --test scripts/db/cutover/d1-shared-key-earnings-history.test.mjs
      - run: node --import tsx --test scripts/db/cutover/d1-shared-key-earnings-projection-index.test.mjs
      - run: node --import tsx --test packages/core/src/db/d1/portal-marketplace-rebuild.test.ts
      - run: node --test scripts/db/cutover/build-request-legacy-parent-census.test.mjs scripts/db/cutover/build-request-legacy-parent-activation.test.mjs scripts/db/cutover/build-request-legacy-parent-default-acl-activation.test.mjs
      - run: node --test packages/proxy/scripts/test-postgres-image-owner-workerd.test.mjs
      - run: npm run typecheck:images:staging -w @octafuse/proxy
      - run: npm run test:images:staging -w @octafuse/proxy
      # Local workerd only: generated test key, intercepted OAuth and denied external egress.
      - run: npm run test:oauth:workerd -w @octafuse/proxy
  native-financial-consumer:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    container:
      image: postgres:18.6-bookworm
      options: --user 0
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: '.nvmrc'
      - run: npm ci
      - run: npm run build:node-index -w @octafuse/core
      # The fixture creates its own loopback cluster; no ambient database URL is used.
      - run: |
          install -d -o postgres -g postgres -m 0755 .wrangler/staging .wrangler/staging/pg-native-dispatch-tests
          # Fixed machine reports are overwritten by fixtures; source directories stay checkout-owned.
          for artifact in \
            docs/developers/architecture/implementation-evidence/C03-postgres-native-replay-scale-lock-v333-report.json \
            docs/developers/architecture/implementation-evidence/C04-authenticated-complete-text-quote-v360-report.json \
            docs/developers/architecture/implementation-evidence/C04-authenticated-request-capability-v356-report.json \
            docs/developers/architecture/implementation-evidence/C04-authenticated-text-route-ceiling-v357-report.json \
            docs/developers/architecture/implementation-evidence/C04-authenticated-text-route-source-fence-v359-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-chat-holder-dispatch-v387-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-admission-buyer-v379-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-all-hold-renewal-v367-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-attempt-grant-v362-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-auth-routing-recovery-coinstall-v400-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-buyer-counter-cutover-v367-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-holder-worker-v390-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-legacy-buyer-held-v368-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-legacy-reaper-fence-v366-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-manifest-selection-v393-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-no-fetch-close-blocker-v382-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-no-fetch-fence-v370-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-no-fetch-platform-close-v388-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-no-fetch-recovery-v389-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-observed-holder-v384-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-platform-close-fence-v386-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-private-route-reader-v366-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-quote-budget-admission-v361-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-read-grant-bridge-v367-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-response-no-fetch-coinstall-v397-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-response-observation-v392-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-result-client-digest-v367-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-result-facts-v366-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-routing-projection-v396-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-secretless-plan-v365-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-secretless-plan-v391-report.json \
            docs/developers/architecture/implementation-evidence/C04-complete-text-send-start-v365-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-commit-ack-v376-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-commit-journal-v378-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-delayed-commit-v377-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-journal-integration-v381-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-request-projection-v383-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-terminal-reader-v375-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-window-accountant-v371-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-windowed-app-privileges-renewal-v376-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-windowed-app-privileges-v374-report.json \
            docs/developers/architecture/implementation-evidence/C04-legacy-buyer-windowed-app-v372-report.json \
            docs/developers/architecture/implementation-evidence/C04-personal-key-auth-period-v395-report.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-credited-usage-gap-v342-results.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-credited-usage-reader-v344-results.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-credited-usage-store-v343-results.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-exclusive-credential-free-chat-ingress-v401-report.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-complete-text-platform-event-delivery-v402-report.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-shared-earning-scanner-v350-results.json \
            docs/developers/architecture/implementation-evidence/C04-postgres-stats-auth-boundary-v346-results.json \
            docs/developers/architecture/implementation-evidence/C04-shared-earning-backlog-observation-v353-results.json \
            docs/developers/architecture/implementation-evidence/C04-stats-claim-reader-v349-results.json \
            docs/developers/architecture/implementation-evidence/C04-stats-signed-claim-v348-results.json; do
            if [ ! -e "$artifact" ]; then
              install -m 0644 /dev/null "$artifact"
            fi
            chown postgres:postgres "$artifact"
            chmod u+rw "$artifact"
          done
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-financial-consumer-login.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/build-financial-consumer-direct-login-grant-lifecycle.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/build-image-fact-job-producer-grant.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-image-http-financial-jsonb-boundary.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-image-edits-http-financial.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-recovery-server-deadline.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-legacy-handler-compat.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-replay-scale-lock.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-earnings-history.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-earnings-projection-index.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-usage-repair-jobs.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-usage-repair-backfill.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-usage-repair-durable-cursor.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-usage-repair-runtime-grant.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/build-shared-key-usage-repair-direct-login-grant.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-usage-repair-failure-isolation.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-usage-repair-durable-claim.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-quote-versions.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-dispatch-quote-attempts.native.test.mjs
      - run: |
          gosu postgres env HOME=/var/lib/postgresql GATEWAY_NATIVE_PG_BIN=/usr/lib/postgresql/18/bin \
            node --import tsx --test scripts/db/cutover/postgres-shared-key-orphan-claim-v347.native.test.mjs

# Copy to .env.gateway，与 gateway.compose.yml 同时使用（外置 Postgres，同时起 proxy + admin）
# docker compose --env-file .env.gateway -f gateway.compose.yml up -d
# migrate：docker compose --env-file .env.gateway -f gateway.compose.yml --profile migrate run --rm migrate
#
# CI 推送命名见 .github/workflows/cinatoken-docker-images.yml（本组织默认如下）。
GATEWAY_PROXY_IMAGE=ghcr.io/cinagroup/cinatoken-proxy:latest
GATEWAY_ADMIN_IMAGE=ghcr.io/cinagroup/cinatoken-admin:latest
GATEWAY_MIGRATE_IMAGE=ghcr.io/cinagroup/cinatoken-migrate:latest
# 任意私有 OCI registry（如自建 Harbor）：按需 mirror / retag，例如：
# GATEWAY_PROXY_IMAGE=registry.example.com/example-org/cinatoken-proxy:latest
# GATEWAY_ADMIN_IMAGE=registry.example.com/example-org/cinatoken-admin:latest
# GATEWAY_MIGRATE_IMAGE=registry.example.com/example-org/cinatoken-migrate:latest

# 宿主机映射（默认 18787 / 18789）；容器内 proxy 固定 8787、admin 固定 8789
GATEWAY_PROXY_PORT=18787
GATEWAY_ADMIN_PORT=18789

DATABASE_URL=postgres://gateway_user:change-me@db.example.com:5432/cinatoken
DATABASE_DRIVER=postgres

# Required: fill with your existing deployment encryption secret (at least 32 characters).
# Admin and Proxy must use the same value; do not replace it when upgrading existing encrypted data.
SHARED_KEY_ENCRYPTION_SECRET=

# Optional server-side Proxy origin; Compose defaults to the colocated gateway-proxy service.
# CINATOKEN_PUBLIC_API_ORIGIN=http://gateway-proxy:8787

# 可选：在 proxy 或 admin 之一设 AUTO_MIGRATE=1，启动时自动迁移（无需单独 migrate Job）
# AUTO_MIGRATE=1

# Legacy compatibility fields still required by this example; password login returns 410.
# Browser sign-in requires separately configured CinaAuth OIDC and HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Enable before exposing Web Config, after the Admin schema and all instances are updated.
# CINATOKEN_ADMIN_CONFIG_REQUIRE_REVISION=true

# Optional Secure flag for a legacy admin_session cookie; it does not enable password login.
# Current CinaAuth cinatoken_session cookies are always Secure and require HTTPS.
# See docs/operators/deployment/docker.md §7.3.
# ADMIN_COOKIE_SECURE=1

  "findings": [
    {
      "id": "F1",
      "kind": "direct-local-source-fact",
      "fact": "CinaToken authorization and token requests use resource=config.appOrigin. The prior immutable source review pins oidc-client.ts:69 and :109; sign-in does not set prompt=none, registration mode alone sets prompt=create. Provider resource audiences are constructed from requested identifiers and an implicit userinfo audience when openid is requested.",
      "sourceRefs": [
        "prior oidc-client.ts:54-74,93-114",
        "resources.ts:507-513"
      ]
    },
    {
      "id": "F2",
      "kind": "direct-local-source-fact",
      "fact": "Provider resource checks return invalid_target for a missing or disabled resource row, and for a missing exact client-to-resource link when default enforcePerClientResources=true. resources config is a seed source, not the authoritative current DB row. insertOnly preserves existing disabled policy.",
      "sourceRefs": [
        "resources.ts:368-403,530-553,631-646,849-885,918-970",
        "authorize.ts:657-684"
      ]
    },
    {
      "id": "F3",
      "kind": "direct-local-source-initialization-omission",
      "fact": "ensureCinatokenOidcClient only upserts oauthClient; it never inserts oauthResource or oauthClientResource. ensureAdminOidcClient separately inserts the exact resource and its link with conflict no-op semantics preserving operator resource policy. With this code and a fresh unlinked client, resource seeding alone cannot satisfy the default per-client check.",
      "sourceRefs": [
        "cinatoken-oidc-client.ts:75-112",
        "admin-oidc-client.ts:128-146",
        "resources.ts:399-402,530-553"
      ]
    },
    {
      "id": "F4",
      "kind": "inference-not-online-branch-proof",
      "fact": "The UI sequence is consistent with authorize fail-fast resource validation. Public origin/client metadata now matches on both sides according to Root. It does not distinguish missing row, intentional disabled row, unlinked client, or an older/different deployed provider implementation; no DB or live code version was read here."
    }
  ],

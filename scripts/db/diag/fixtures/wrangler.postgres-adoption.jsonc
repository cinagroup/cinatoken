{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  // Build-only mirror of the actual proxy entry and compatibility settings. No bindings,
  // routes, credentials, build hooks or account. Harness ALWAYS passes --dry-run.
  "name": "postgres-adoption-build-only",
  "main": "../../../../packages/proxy/src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "send_metrics": false
}
